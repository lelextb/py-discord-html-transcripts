# Discord Bot Token (required)
DISCORD_TOKEN=your_bot_token_here

# Server (Guild) ID where the bot operates (required)
SERVER_ID=123456789012345678

# Directory where HTML transcripts will be saved (default: transcripts)
TRANSCRIPT_DIR=transcripts

# Maximum number of messages to fetch per transcript (0 = unlimited)
MAX_MESSAGES=0

# Optional: Local path to quest badge icon (PNG/SVG)
QUEST_BADGE_PATH=assets/quest.png